{
  "expo": {
    "name": "RoyalAgents",
    "slug": "royal-agents",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "royalagents",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.royalagents.app",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "dev.royalagents.app"
    },
    "extra": {
      "privyAppId": "cmjmztc9n00ctld0c2he2owwn",
      "privyClientId": "client-WY6UFs6MfaSSSmoF4XVApJVao3CSNpzyrCTx9ioF6mRzx",
      "backendUrl": "http://10.0.0.29:4020",
      "movementBackendUrl": "http://10.0.0.29:3000",
      "movePackageAddress": "0xe0e83d0f83cf7b7f7e3dd8e39dd3c4cfbbc48be25853c49f8ec32faf0acae9e1"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.5"
          },
          "android": {
            "compileSdkVersion": 35
          }
        }
      ],
      "expo-font",
      "./plugins/strip-ios-entitlements"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
