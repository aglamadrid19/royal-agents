# Backend
PORT=4020
DATABASE_PATH=./royal_agents.db
MOVEMENT_RPC_URL=https://testnet.movementlabs.xyz/v1
MOVE_PACKAGE_ADDRESS=0xYOUR_PACKAGE_ADDRESS
MOVEMENT_FEE_MANAGER_PRIVATE_KEY=0xYOUR_FEE_MANAGER_PRIVATE_KEY
API_KEY_ENC_SECRET=BASE64_32_BYTES
X402_NETWORK=movement
X402_FACILITATOR_URL=https://facilitator.stableyard.fi
# Optional fallback pay-to for non-Movement networks
X402_PAY_TO_ADDRESS=0xYOUR_MOVEMENT_ADDRESS
X402_ASSET=0x1::aptos_coin::AptosCoin
X402_USD_PER_MOVE=1
X402_MOVE_DECIMALS=8
X402_MAX_TIMEOUT_SECONDS=600
OPENAI_DEFAULT_MODEL=gpt-4o-mini
ANTHROPIC_DEFAULT_MODEL=claude-3-haiku-20240307
ALLOWED_ORIGINS=*

# App (set in app/app.json extra.backendUrl or Expo env)
EXPO_PUBLIC_BACKEND_URL=http://localhost:4020
